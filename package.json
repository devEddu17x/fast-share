{
  "name": "fast-share",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "build:web": "vite build",
    "build": "vite build && tsc --noEmit",
    "dev": "vite build && wrangler dev",
    "deploy": "pnpm run build && wrangler deploy",
    "infra:init": "./scripts/setup.sh",
    "d1:migrate:local": "echo y | wrangler d1 migrations apply fast-share-db --local",
    "d1:migrate:remote": "echo y | wrangler d1 migrations apply fast-share-db --remote"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "hono": "^4.7.2",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^26.6.3",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "wrangler": "^3.114.0"
  }
}
